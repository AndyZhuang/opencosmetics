  "rule_categories": {
    "compatibility": {
      "description": {
        "zh": "成分配伍不相容 (拮抗、降解、不稳定)",
        "en": "Ingredient pair incompatibilities (antagonism, degradation, instability)"
      },
      "rules": [
        {
          "id": "COMP-001",
          "severity": "block",
          "ingredients": [
            "RETINOL",
            "VITAMIN_C"
          ],
          "rationale": {
            "zh": "酸度冲突 (低 pH 维 C 破坏视黄醇活性, 顺序不对导致刺激)",
            "en": "pH conflict (low-pH Vitamin C degrades retinol activity; wrong order causes irritation)"
          },
          "alternatives": {
            "zh": [
              "VITAMIN_C_AM",
              "RETINAL"
            ],
            "en": [
              "Vitamin C Ascorbyl Magnesium (SAP)",
              "Retinal (more stable retinoid)"
            ]
          }
        },
        {
          "id": "COMP-002",
          "severity": "warn",
          "ingredients": [
            "RETINOL",
            "AHA"
          ],
          "rationale": {
            "zh": "双重角质剥脱 → 屏障受损",
            "en": "Double exfoliation → barrier damage"
          },
          "alternatives": {
            "zh": [
              "隔天使用",
              "PHAs"
            ],
            "en": [
              "Alternate day usage",
              "Switch to PHAs (gentler)"
            ]
          }
        },
        {
          "id": "COMP-003",
          "severity": "warn",
          "ingredients": [
            "RETINOL",
            "BHA"
          ],
          "rationale": {
            "zh": "双重角质剥脱",
            "en": "Double exfoliation"
          },
          "alternatives": {
            "zh": [
              "降低 BHA 浓度"
            ],
            "en": [
              "Reduce BHA concentration"
            ]
          }
        },
        {
          "id": "COMP-004",
          "severity": "block",
          "ingredients": [
            "BENZOYL_PEROXIDE",
            "VITAMIN_C"
          ],
          "rationale": {
            "zh": "BPO 氧化维 C (L-抗坏血酸失效), 间隔 ≥ 2h",
            "en": "BPO oxidizes Vitamin C (deactivates L-Ascorbic Acid); space ≥ 2h"
          },
          "alternatives": {
            "zh": [
              "VITAMIN_C_AM"
            ],
            "en": [
              "Use SAP (more stable Vitamin C)"
            ]
          }
        },
        {
          "id": "COMP-005",
          "severity": "warn",
          "ingredients": [
            "BENZOYL_PEROXIDE",
            "RETINOL"
          ],
          "rationale": {
            "zh": "BPO 使视黄醇失活",
            "en": "BPO deactivates retinol"
          },
          "alternatives": {
            "zh": [
              "隔天使用"
            ],
            "en": [
              "Alternate day usage"
            ]
          }
        },
        {
          "id": "COMP-006",
          "severity": "warn",
          "ingredients": [
            "RETINOL",
            "NIACINAMIDE"
          ],
          "rationale": {
            "zh": "高浓度时可能泛红 (低浓度无问题)",
            "en": "May cause flushing at high concentrations (low concentrations are safe)"
          },
          "alternatives": {
            "zh": [
              "间隔使用"
            ],
            "en": [
              "Space out applications"
            ]
          }
        },
        {
          "id": "COMP-007",
          "severity": "block",
          "ingredients": [
            "VITAMIN_C",
            "NIACINAMIDE"
          ],
          "rationale": {
            "zh": "高浓度时形成烟酸, 引起泛红 (传统认知, 现代配方已稳定化)",
            "en": "High concentrations form nicotinic acid → flushing (traditional view; modern formulas stabilized)"
          },
          "alternatives": {
            "zh": [
              "使用稳定衍生物 (SAP, MAP)"
            ],
            "en": [
              "Use stabilized derivatives (SAP, MAP)"
            ]
          }
        },
        {
          "id": "COMP-008",
          "severity": "warn",
          "ingredients": [
            "RETINOL",
            "VITAMIN_A_PALMITATE"
          ],
          "rationale": {
            "zh": "叠加维 A 类, 刺激过强",
            "en": "Stacked retinoids → excessive irritation"
          }
        },
        {
          "id": "COMP-009",
          "severity": "warn",
          "ingredients": [
            "GLYCERIN",
            "DIMETHICONE"
          ],
          "rationale": {
            "zh": "硅油阻水, 降低甘油保湿",
            "en": "Silicone occludes water → reduces glycerin humectant effect"
          }
        },
        {
          "id": "COMP-010",
          "severity": "warn",
          "ingredients": [
            "AHA",
            "BHA"
          ],
          "rationale": {
            "zh": "双重去角质",
            "en": "Double exfoliation"
          }
        },
        {
          "id": "COMP-011",
          "severity": "warn",
          "ingredients": [
            "COPPER_PEPTIDES",
            "VITAMIN_C"
          ],
          "rationale": {
            "zh": "铜肽结合维 C 螯合, 双方活性降低",
            "en": "Copper chelates with Vitamin C → both lose activity"
          },
          "alternatives": {
            "zh": [
              "分时段使用"
            ],
            "en": [
              "Use at different times of day"
            ]
          }
        },
        {
          "id": "COMP-012",
          "severity": "warn",
          "ingredients": [
            "RETINOL",
            "GLYCOLIC_ACID"
          ],
          "rationale": {
            "zh": "双重角质剥脱 + 酸性环境破坏视黄醇",
            "en": "Double exfoliation + acidic pH degrades retinol"
          }
        },
        {
          "id": "COMP-013",
          "severity": "block",
          "ingredients": [
            "SALICYLIC_ACID",
            "BENZOYL_PEROXIDE"
          ],
          "rationale": {
            "zh": "酸碱中和, 双方失活",
            "en": "Acid-base neutralization → both lose activity"
          }
        },
        {
          "id": "COMP-014",
          "severity": "warn",
          "ingredients": [
            "RETINOL",
            "VITAMIN_C"
          ],
          "context": "孕妇",
          "rationale": {
            "zh": "维 A 类致畸, 孕期禁用 (TGA Category D)",
            "en": "Retinoids are teratogenic; contraindicated in pregnancy (TGA Cat D / FDA Cat X)"
          }
        },
        {
          "id": "COMP-015",
          "severity": "warn",
          "ingredients": [
            "HYDROQUINONE",
            "BENZOYL_PEROXIDE"
          ],
          "rationale": {
            "zh": "BPO 氧化氢醌, 产生黑褐色染色",
            "en": "BPO oxidizes hydroquinone → dark brown staining"
          }
        }
      ]
    },
    "ph_safety": {
      "description": {
        "zh": "pH 范围和稳定性规则",
        "en": "pH range and stability rules"
      },
      "rules": [
        {
          "id": "PH-001",
          "severity": "block",
          "context": "驻留类成人",
          "pH_min": 4.5,
          "pH_max": 7.5,
          "source": "儿童化妆品技术指导原则"
        },
        {
          "id": "PH-002",
          "severity": "block",
          "context": "淋洗类成人",
          "pH_min": 4.5,
          "pH_max": 8.5
        },
        {
          "id": "PH-003",
          "severity": "block",
          "context": "儿童驻留类 (0-12)",
          "pH_min": 4.5,
          "pH_max": 7.5,
          "source": "GB 7916-2026 + 儿童化妆品技术指导原则"
        },
        {
          "id": "PH-004",
          "severity": "block",
          "context": "儿童淋洗类 (0-12)",
          "pH_min": 4.5,
          "pH_max": 8.5
        },
        {
          "id": "PH-005",
          "severity": "warn",
          "context": "婴幼儿尿布区",
          "pH_max": 8.5,
          "rationale": {
            "zh": "低 pH 刺激尿布区皮肤, 需 ≥ 4.5 但允许偏碱到 8.5",
            "en": "Low pH irritates diaper-area skin; require pH ≥ 4.5 but allow up to 8.5"
          }
        },
        {
          "id": "PH-006",
          "severity": "warn",
          "ingredient": "AHA",
          "context": "驻留类",
          "pH_required_min": 3.5,
          "pH_required_max": 4.0,
          "rationale": {
            "zh": "驻留类 AHA 有效 pH < 4.0, 否则效果不佳",
            "en": "Leave-on AHA effective at pH < 4.0; otherwise poor efficacy"
          }
        },
        {
          "id": "PH-007",
          "severity": "warn",
          "ingredient": "BHA",
          "context": "驻留类",
          "pH_required_min": 3.0,
          "pH_required_max": 4.0,
          "rationale": {
            "zh": "BHA 在 pH 3-4 最稳定有效",
            "en": "BHA most stable and effective at pH 3-4"
          }
        },
        {
          "id": "PH-008",
          "severity": "block",
          "ingredient": "VITAMIN_C",
          "context": "L-Ascorbic Acid",
          "pH_required_min": 2.5,
          "pH_required_max": 3.5,
          "rationale": {
            "zh": "L-抗坏血酸在 pH > 3.5 失活; < 2.5 刺激",
            "en": "L-Ascorbic acid inactive at pH > 3.5; irritating at pH < 2.5"
          }
        }
      ]
    },
    "concentration_limits": {
      "description": {
        "zh": "受限原料最大浓度 (STSC 2015 + EU + FDA)",
        "en": "Max concentration for restricted ingredients (STSC 2015 + EU + FDA)"
      },
      "rules": [
        {
          "id": "CONC-001",
          "ingredient": "RETINOL",
          "leave_on_max_pct": 0.05,
          "rinse_off_max_pct": 0.3,
          "source": "EU SCCS 2022"
        },
        {
          "id": "CONC-002",
          "ingredient": "AHA",
          "leave_on_max_pct": 10,
          "rinse_off_max_pct": 20,
          "label": "≥ 10% 需 pH < 4"
        },
        {
          "id": "CONC-003",
          "ingredient": "BHA_SALICYLIC_ACID",
