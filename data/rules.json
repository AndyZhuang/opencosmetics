          "children_max_pct": 25,
          "note": {
            "zh": "GB 7916-2026 + 儿童指导原则",
            "en": "GB 7916-2026 + children guidance"
          }
        }
      ]
    },
    "special_populations": {
      "description": {
        "zh": "孕妇、婴幼儿、敏感肌警告",
        "en": "Warnings for pregnant, infant, sensitive skin"
      },
      "rules": [
        {
          "id": "POP-001",
          "severity": "block",
          "context": "孕妇",
          "ingredients": [
            "RETINOL",
            "TRETINOIN",
            "ADAPALENE",
            "TAZAROTENE",
            "ISOTRETINOIN"
          ],
          "rationale": {
            "zh": "维 A 类致畸, TGA Cat D / FDA Cat X",
