{
  "name": "formulalab-taro",
  "version": "0.1.0",
  "private": true,
  "description": "配方引擎 FormulaLab — 微信小程序 / H5 / React Native 三端同码",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "node scripts/build.mjs weapp",
    "build:h5": "node scripts/build.mjs h5",
    "build:rn": "node scripts/build.mjs rn",
    "build:all": "node scripts/build.mjs weapp && node scripts/build.mjs h5",
    "dev:weapp": "node scripts/build.mjs weapp --watch",
    "dev:h5": "node scripts/build.mjs h5 --watch",
    "dev:rn": "node scripts/build.mjs rn --watch",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.4",
    "ios >= 9"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-root-siblings": "^5.0.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@prefresh/babel-plugin": "^0.5.4",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/metro-config": "0.73.5",
    "@tarojs/cli": "4.3.0",
    "@tarojs/components-rn": "^4.3.0",
    "@tarojs/plugin-html": "4.3.0",
    "@tarojs/rn-runner": "4.3.0",
    "@tarojs/rn-supporter": "4.3.0",
    "@tarojs/runtime-rn": "^4.3.0",
    "@tarojs/taro-rn": "^4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "^18.3.1",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.0",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.38",
    "react-native": "^0.73.11",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.8",
    "stylelint": "16.10.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0",
    "webpack-dev-server": "^4.15.2"
  }
}
